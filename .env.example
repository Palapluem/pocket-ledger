# Placeholders only. Copy to .env locally and supply real values; never commit .env.
DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/pocket_ledger
# At least 32 random characters; keep out of Git and client code.
JWT_SECRET=
JWT_ISSUER=pocket-ledger
JWT_AUDIENCE=pocket-ledger-web
JWT_TTL_SECONDS=3600
CORS_ORIGIN=http://localhost:3001
# Set true under HTTPS to add the Secure cookie attribute.
COOKIE_SECURE=false
PORT=3000
# Seed (JSON array of {email, displayName, role, password}); supply locally.
SEED_USERS_JSON=
# Integration tests: disposable database from scripts/test-db.sh
TEST_DATABASE_URL=
