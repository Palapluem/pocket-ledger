{
	"name": "pocket-ledger",
	"private": true,
	"type": "module",
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"scripts": {
		"dev:server": "bun run --hot apps/server/src/index.ts",
		"test": "bun test apps/server",
		"test:e2e": "playwright test",
		"check-types": "tsc --noEmit -p apps/server && tsc --noEmit -p packages/db && tsc --noEmit -p apps/web",
		"build:web": "cd apps/web && bun x vite build",
		"dev:web": "cd apps/web && bunx vite",
		"check": "biome check --write .",
		"db:generate": "cd packages/db && bunx drizzle-kit generate",
		"db:migrate": "cd packages/db && bun run src/migrate.ts",
		"db:seed": "cd packages/db && bun run src/seed.ts"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.2",
		"@playwright/test": "^1.65.1",
		"@pocket-ledger/config": "workspace:*",
		"@types/bun": "^1.4.3",
		"typescript": "^6.0.3"
	},
	"packageManager": "bun@1.4.4"
}
